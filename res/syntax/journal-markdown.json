{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "fileTypes": [],
    "injectionSelector": "L:text.html.markdown -markup.fenced_code -markup.raw -markup.inline.raw",
    "patterns": [
        {
            "include": "#checklist"
        },
        {
            "include": "#refs"
        }
    ],
    "repository": {
        "refs": {
            "patterns": [
                {
                    "comment": "A tag as Input.extractScopeAndTags reads it (#, then letters, digits, _ or -), with the identifier of a key (#acme:12) as journal-core reads it (refs.ts), then a space or the line end. The extension shows scope tags in their own color.",
                    "match": "(?<!\\S)(#[\\w-]+)(:\\d+)?(?=\\s|$)",
                    "captures": {
                        "1": {
                            "name": "text.html.markdown.journal.scope entity.name.tag"
                        },
                        "2": {
                            "name": "text.html.markdown.journal.key constant.numeric"
                        }
                    }
                },
                {
                    "comment": "A key in the default scope: :N as a whole word; 10:30 is none",
                    "match": "(?<!\\S)(:\\d+)(?=\\s|$)",
                    "captures": {
                        "1": {
                            "name": "text.html.markdown.journal.key constant.numeric"
                        }
                    }
                }
            ]
        },
        "checklist": {
            "patterns": [
                {
                    "match": "^\\s*(-|\\*)\\s+(\\[\\s?\\])\\s*(?i:((?:task|todo):?))?\\s(.*)",
                    "name": "text.html.markdown.journal.task.open",
                    "captures": {
                        "1": {
                            "name": "text.html.markdown.journal.task.open.bullet punctuation.definition.list.begin.markdown"
                        },
                        "2": {
                            "name": "text.html.markdown.journal.task.open.marker keyword.other.task"
                        },
                        "3": {
                            "name": "text.html.markdown.journal.task.open.keyword markup.italic"
                        },
                        "4": {
                            "name": "text.html.markdown.journal.task.open.text",
                            "patterns": [
                                {
                                    "include": "#refs"
                                }
                            ]
                        }
                    }
                },
                {
                    "match": "^\\s*(-|\\*)\\s+(\\[\\/\\])\\s*(?i:((?:task|todo):?))?\\s(.*)",
                    "name": "text.html.markdown.journal.task.progress",
                    "captures": {
                        "1": {
                            "name": "text.html.markdown.journal.task.progress.bullet punctuation.definition.list.begin.markdown"
                        },
                        "2": {
                            "name": "text.html.markdown.journal.task.progress.marker keyword.other.task markup.changed"
                        },
                        "3": {
                            "name": "text.html.markdown.journal.task.progress.keyword markup.italic"
                        },
                        "4": {
                            "name": "text.html.markdown.journal.task.progress.text",
                            "patterns": [
                                {
                                    "include": "#refs"
                                }
                            ]
                        }
                    }
                },
                {
                    "match": "^\\s*(-|\\*)\\s+(\\[[xX]\\])\\s*(?i:((?:task|todo):?))?\\s(.*)",
                    "name": "text.html.markdown.journal.task.completed",
                    "captures": {
                        "1": {
                            "name": "text.html.markdown.journal.task.completed.bullet punctuation.definition.list.begin.markdown"
                        },
                        "2": {
                            "name": "text.html.markdown.journal.task.completed.marker comment"
                        },
                        "3": {
                            "name": "text.html.markdown.journal.task.completed.keyword comment"
                        },
                        "4": {
                            "name": "text.html.markdown.journal.task.completed.text comment",
                            "patterns": [
                                {
                                    "include": "#refs"
                                }
                            ]
                        }
                    }
                },
                {
                    "match": "^\\s*(-|\\*)\\s+(\\[[<>]\\])\\s*(?i:((?:task|todo):?))?\\s(.*)",
                    "name": "text.html.markdown.journal.task.shifted",
                    "captures": {
                        "1": {
                            "name": "text.html.markdown.journal.task.shifted.bullet punctuation.definition.list.begin.markdown"
                        },
                        "2": {
                            "name": "text.html.markdown.journal.task.shifted.marker comment"
                        },
                        "3": {
                            "name": "text.html.markdown.journal.task.shifted.keyword comment"
                        },
                        "4": {
                            "name": "text.html.markdown.journal.task.shifted.text comment",
                            "patterns": [
                                {
                                    "include": "#refs"
                                }
                            ]
                        }
                    }
                },
                {
                    "match": "^\\s*(-|\\*)\\s+(?i:((?:memo|link|note):?))(?=\\s|$)",
                    "name": "text.html.markdown.journal.memo",
                    "captures": {
                        "1": {
                            "name": "text.html.markdown.journal.memo.bullet punctuation.definition.list.begin.markdown"
                        },
                        "2": {
                            "name": "text.html.markdown.journal.memo.keyword markup.italic"
                        }
                    }
                }
            ]
        }
    },
    "scopeName": "text.markdown.journal"
}
