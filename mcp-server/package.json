{
  "name": "journal-mcp-server",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic MCP server for a vscode-journal markdown journal (tasks, time tracking, notes).",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build:core && tsc",
    "typecheck": "npm run build:core && tsc --noEmit && tsc -p tsconfig.test.json",
    "start": "node dist/http.js",
    "start:stdio": "node dist/stdio.js",
    "dev": "tsx watch src/http.ts",
    "dev:stdio": "tsx src/stdio.ts",
    "test": "npm run build:core && tsx --test test/*.test.ts",
    "postinstall": "npm --prefix ../packages/journal-core ci --no-audit --no-fund",
    "build:core": "tsc -p ../packages/journal-core"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "journal-core": "file:../packages/journal-core",
    "jsonc-parser": "^3.3.1",
    "moment": "^2.31.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0"
  }
}
