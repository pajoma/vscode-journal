# Local configuration for VS Code (.vscode/mcp.json and launch.json). Copy to .env.local.

JOURNAL_REPO_PATH=~/Developer/journal
JOURNAL_BASE_PATH=
JOURNAL_TIMEZONE=Europe/Berlin

# Locally you commit yourself; set to true to let the server pull/commit/push.
GIT_SYNC=false

# Locally (company Claude account) notes may be read; content tagged #private never is.
NOTES_READABLE=true
PRIVATE_TAGS=

# Only needed for the HTTP launch configuration. Generate with: openssl rand -hex 32
MCP_AUTH_TOKEN=YOUR_TOKEN_HERE
PORT=3000
