# Local configuration for VS Code (.vscode/mcp.json and launch.json). Copy to .env.local.

# Your VS Code settings, the server only reads the "journal.*" keys.
# Linux: ~/.config/Code/User/settings.json, Windows: %APPDATA%\Code\User\settings.json
JOURNAL_SETTINGS=~/Library/Application Support/Code/User/settings.json
# Git working copy of the journal; optional if journal.base is absolute (it then defaults to journal.base)
JOURNAL_REPO_PATH=
JOURNAL_TIMEZONE=Europe/Berlin

# Locally you commit yourself; set to true to let the server pull/commit/push.
GIT_SYNC=false

# Locally (company Claude account) notes may be read; content tagged #private never is.
NOTES_READABLE=true
PRIVATE_TAGS=

# Only needed for the HTTP launch configuration. Generate with: openssl rand -hex 32
MCP_AUTH_TOKEN=YOUR_TOKEN_HERE
PORT=3000
