  "full": [
    {
      "name": "get_daily_journal",
      "title": "Get daily journal",
      "description": "Returns one day's entry structured as memos, tasks, time entries and notes.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "date": {
            "description": "YYYY-MM-DD, 'today', 'yesterday' or 'tomorrow' (default: today)",
            "type": "string"
          }
        },
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "readOnlyHint": true
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "get_weekly_journal",
      "title": "Get weekly journal",
      "description": "Returns the weekly entry of the week containing 'date': memos, tasks and notes.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "date": {
            "description": "YYYY-MM-DD, 'today', 'yesterday' or 'tomorrow' (default: today)",
            "type": "string"
          }
        },
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "readOnlyHint": true
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "get_daily_briefing",
      "title": "Daily briefing",
      "description": "Facts for a daily briefing: memos and tasks of the day and of the current week, open tasks carried over from previous days and the previous week, time booked, note topics. Summarise them for the user; open tasks are numbered ('no'): show the numbers.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "date": {
            "description": "YYYY-MM-DD, 'today', 'yesterday' or 'tomorrow' (default: today)",
            "type": "string"
          },
          "lookback_days": {
            "description": "Previous days to scan for open daily tasks (default 7)",
            "type": "integer",
            "minimum": 0,
            "maximum": 31
          }
        },
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "readOnlyHint": true
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "add_memo",
      "title": "Add memo",
      "description": "Adds a one-line memo (reminder) to a daily or weekly entry, rendered with the user's memo template.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "date": {
            "description": "YYYY-MM-DD, 'today', 'yesterday' or 'tomorrow' (default: today)",
            "type": "string"
          },
          "period": {
            "description": "'daily' (default): the day's entry; 'weekly': the weekly entry of the week containing 'date'",
            "type": "string",
            "enum": [
              "daily",
              "weekly"
            ]
          },
          "text": {
            "type": "string",
            "description": "Memo text, single line"
          }
        },
        "required": [
          "text"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "list_tasks",
      "title": "List tasks",
      "description": "Lists checklist tasks of daily and/or weekly entries over a date range, with the heading each task is listed under. Tasks are numbered ('no'): show the numbers.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "from": {
            "description": "First day, YYYY-MM-DD or keyword (default: today)",
            "type": "string"
          },
          "to": {
            "description": "Last day, inclusive (default: same as 'from'); max. 92 days",
            "type": "string"
          },
          "status": {
            "description": "Default: open",
            "type": "string",
            "enum": [
              "open",
              "done",
              "moved",
              "all"
            ]
          },
          "period": {
            "description": "Daily entries, weekly entries of the weeks in the range, or both (default)",
            "type": "string",
            "enum": [
              "daily",
              "weekly",
              "all"
            ]
          }
        },
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "readOnlyHint": true
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "add_task",
      "title": "Add task",
      "description": "Adds an open task to a daily or weekly entry, rendered with the user's task template.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "date": {
            "description": "YYYY-MM-DD, 'today', 'yesterday' or 'tomorrow' (default: today)",
            "type": "string"
          },
          "period": {
            "description": "'daily' (default): the day's entry; 'weekly': the weekly entry of the week containing 'date'",
            "type": "string",
            "enum": [
              "daily",
              "weekly"
            ]
          },
          "text": {
            "type": "string",
            "description": "Task text, single line"
          }
        },
        "required": [
          "text"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "update_task",
      "title": "Update task",
      "description": "Completes a task (adds '(done: <time>)'), reopens it, and/or rewords it.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "date": {
            "description": "YYYY-MM-DD, 'today', 'yesterday' or 'tomorrow' (default: today)",
            "type": "string"
          },
          "period": {
            "description": "'daily' (default): the day's entry; 'weekly': the weekly entry of the week containing 'date'",
            "type": "string",
            "enum": [
              "daily",
              "weekly"
            ]
          },
          "ref": {
            "type": "string",
            "description": "Temporary ref of the entry, as returned by a read tool"
          },
          "done": {
            "description": "true = completed, false = reopen",
            "type": "boolean"
          },
          "text": {
            "description": "New task text",
            "type": "string"
          }
        },
        "required": [
          "ref"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "move_task",
      "title": "Move task",
      "description": "Moves an open task to another day or week: marks it '[>] ... (moved: <target>)' and adds it to the target entry. Works between daily and weekly entries.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "date": {
            "description": "YYYY-MM-DD, 'today', 'yesterday' or 'tomorrow' (default: today)",
            "type": "string"
          },
          "period": {
            "description": "'daily' (default): the day's entry; 'weekly': the weekly entry of the week containing 'date'",
            "type": "string",
            "enum": [
              "daily",
              "weekly"
            ]
          },
          "ref": {
            "type": "string",
            "description": "Temporary ref of the entry, as returned by a read tool"
          },
          "to": {
            "type": "string",
            "description": "Target day (or a day of the target week), YYYY-MM-DD or keyword"
          },
          "to_period": {
            "description": "Target entry type (default: same as 'period')",
            "type": "string",
            "enum": [
              "daily",
              "weekly"
            ]
          }
        },
        "required": [
          "ref",
          "to"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "migrate_open_tasks",
      "title": "Migrate open tasks",
      "description": "Moves all open tasks of a daily or weekly entry to another entry (default: the next day, or the next week for weekly entries).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "date": {
            "description": "YYYY-MM-DD, 'today', 'yesterday' or 'tomorrow' (default: today)",
            "type": "string"
          },
          "period": {
            "description": "'daily' (default): the day's entry; 'weekly': the weekly entry of the week containing 'date'",
            "type": "string",
            "enum": [
              "daily",
              "weekly"
            ]
          },
          "to": {
            "description": "Target day or a day of the target week (default: next day / next week)",
            "type": "string"
          },
          "to_period": {
            "description": "Target entry type (default: same as 'period')",
            "type": "string",
            "enum": [
              "daily",
              "weekly"
            ]
          }
        },
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
