    {
      "name": "create_note",
      "title": "Create note",
      "description": "Creates a new note (e.g. a concept) in a scope from the user's note template and links it from the daily entry. Never overwrites; use append_to_note to extend a note.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "scope": {
            "type": "string",
            "description": "Scope name, with or without '#', e.g. 'vera'"
          },
          "title": {
            "type": "string",
            "description": "Note title; also the file name"
          },
          "content": {
            "type": "string",
            "description": "Markdown body of the note"
          },
          "tags": {
            "description": "Additional tags, e.g. ['concept']",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "link": {
            "description": "Link the note from the daily entry (default true)",
            "type": "boolean"
          },
          "date": {
            "description": "Day whose entry links the note (default: today)",
            "type": "string"
          }
        },
        "required": [
          "scope",
          "title",
          "content"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
