            "type": "boolean"
          },
          "date": {
            "description": "Day whose entry links the note (default: today)",
            "type": "string"
          }
        },
        "required": [
          "scope",
          "title",
          "content"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    }
  ]
}
