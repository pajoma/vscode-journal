# Container configuration (docker compose). Copy to .env on the NAS, never commit .env.

# Token with full access to /mcp. Generate with: openssl rand -hex 32
MCP_AUTH_TOKEN=YOUR_TOKEN_HERE
# Optional second token that can only add tasks, time entries and notes (reads nothing back)
MCP_WRITE_TOKEN=

# Note content is not returned unless set to true. Tasks and time entries stay readable.
NOTES_READABLE=false
# #private and #privat are always applied; add further tags comma-separated
PRIVATE_TAGS=

# Journal folder inside the repository ("" = repository root)
JOURNAL_BASE_PATH=
JOURNAL_TIMEZONE=Europe/Berlin

GIT_BRANCH=master
GIT_AUTHOR_NAME=Journal MCP
GIT_AUTHOR_EMAIL=journal-mcp@example.invalid
GIT_COMMITTER_NAME=Journal MCP
GIT_COMMITTER_EMAIL=journal-mcp@example.invalid
