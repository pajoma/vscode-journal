{
  "$comment": "Journal format cases run by both the extension (src/test/suite/journal-format.test.ts) and the MCP server (mcp-server/test/contract.test.ts), #250. Settings use the keys of journal.* without the prefix; expected paths are relative to journal.base. Week paths have no ${year} here: the extension fills it with the current year, the MCP server with the week-year.",
  "date": "2026-10-09",
  "entries": [
    { "name": "default patterns", "settings": {}, "expected": "2026/10/09.md" },
    {
      "name": "own patterns and extension",
      "settings": { "ext": "txt", "patterns": { "entries": { "path": "${base}/${year}", "file": "${year}-${month}-${day}.${ext}" } } },
      "expected": "2026/2026-10-09.txt"
    },
    {
      "name": "moment formats",
      "settings": { "locale": "de", "patterns": { "entries": { "path": "${base}/${d:YYYY}/${d:MM-MMMM}", "file": "${d:YYYY-MM-DD}.${ext}" } } },
      "expected": "2026/10-Oktober/2026-10-09.md"
    }
  ],
  "weeks": [
    {
      "name": "week file name",
      "settings": { "patterns": { "weeks": { "path": "${base}/weeks", "file": "week_${week}.${ext}" } } },
      "week": 41,
      "expected": "weeks/week_41.md"
    },
    {
      "name": "week in German locale",
      "settings": { "locale": "de", "patterns": { "weeks": { "path": "${base}/kw", "file": "KW${week}.${ext}" } } },
      "week": 41,
      "expected": "kw/KW41.md"
    }
  ],
  "notes": [
    {
      "name": "configured scope without own pattern uses journal.patterns.notes",
      "settings": { "scopes": [{ "name": "work" }] },
      "scope": "work",
      "title": "Konzept Schnittstelle",
      "expected": "2026/10/09/Konzept_Schnittstelle.md"
    },
    {
      "name": "configured scope with own notes pattern",
      "settings": { "scopes": [{ "name": "work", "patterns": { "notes": { "path": "${base}/work/${year}", "file": "${d:YYYY-MM-DD}_${input}.${ext}" } } }] },
      "scope": "work",
      "title": "Konzept Schnittstelle",
      "expected": "work/2026/2026-10-09_Konzept_Schnittstelle.md"
    },
    {
      "name": "folder scope below journal.scopeRoot",
      "settings": {},
      "folders": ["vera"],
      "scope": "vera",
      "title": "Konzept Schnittstelle",
      "expected": "scopes/vera/Konzept_Schnittstelle.md"
    }
  ],
  "filenames": [
    ["Konzept Schnittstelle", "Konzept_Schnittstelle"],
    ["  trimmed  ", "trimmed"],
    ["a/b\\c: d?", "a-b-c-_d-"],
    ["<x|y*z>", "-x-y-z-"]
  ],
  "templates": [
    { "template": "${year}-${month}-${day}", "locale": "en", "expected": "2026-10-09" },
    { "template": "${weekday}, ${localDate}", "locale": "en", "expected": "Friday, October 9, 2026" },
    { "template": "${weekday}, ${localDate}", "locale": "de", "expected": "Freitag, 9. Oktober 2026" },
    { "template": "# ${d:dddd, MMMM DD YYYY}", "locale": "en", "expected": "# Friday, October 09 2026" },
    { "template": "Week ${week}", "locale": "en", "expected": "Week 41" }
  ]
}
