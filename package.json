{
  "name": "vscode-journal",
  "displayName": "%displayName%",
  "description": "%description%",
  "keywords": [
    "journal",
    "diary",
    "notes",
    "memo",
    "tasks"
  ],
  "version": "1.0.3",
  "license": "GPL-3.0-or-later",
  "publisher": "pajoma",
  "engines": {
    "vscode": "^1.118.0"
  },
  "author": {
    "name": "Patrick Maué"
  },
  "icon": "img/logo.png",
  "galleryBanner": {
    "color": "#d7eef4",
    "theme": "light"
  },
  "categories": [
    "Other"
  ],
  "private": true,
  "extensionKind": [
    "workspace"
  ],
  "l10n": "./l10n",
  "capabilities": {
    "virtualWorkspaces": {
      "supported": "limited",
      "description": "vscode-journal resolves the journal base directory from \"journal.base\" and writes files via the local filesystem. In a virtual workspace, write operations to local paths are unavailable; read-only browsing of existing entries may still work."
    },
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "vscode-journal writes files to the directory configured in \"journal.base\", which can be overridden by workspace settings. In untrusted workspaces the user-level \"journal.base\" is used and workspace overrides of that setting are ignored.",
      "restrictedConfigurations": [
        "journal.base"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pajoma/vscode-journal.git"
  },
  "bugs": {
    "url": "https://github.com/pajoma/vscode-journal/issues",
    "email": "pajoma@gmail.com"
  },
  "main": "./dist/extension.js",
  "contributes": {
    "markdown.markdownItPlugins": true,
    "commands": [
      {
        "command": "journal.today",
        "title": "%command.journal.today.title%",
        "category": "%command.category.journal%"
      },
      {
        "command": "journal.yesterday",
        "title": "%command.journal.yesterday.title%",
        "category": "%command.category.journal%"
      },
      {
        "command": "journal.tomorrow",
        "title": "%command.journal.tomorrow.title%",
        "category": "%command.category.journal%"
      },
      {
        "command": "journal.memo",
        "title": "%command.journal.memo.title%",
        "category": "%command.category.journal%"
      },
      {
        "command": "journal.note",
        "title": "%command.journal.note.title%",
        "category": "%command.category.journal%"
      },
      {
        "command": "journal.printTime",
        "title": "%command.journal.printTime.title%",
        "category": "%command.category.journal%"
      },
      {
        "command": "journal.printDuration",
        "title": "%command.journal.printDuration.title%",
        "category": "%command.category.journal%"
      },
      {
        "command": "journal.printSum",
        "title": "%command.journal.printSum.title%",
        "category": "%command.category.journal%"
      },
      {
        "command": "journal.day",
        "title": "%command.journal.day.title%",
        "category": "%command.category.journal%"
      },
      {
        "command": "journal.open",
        "title": "%command.journal.open.title%",
        "category": "%command.category.journal%"
      },
      {
        "command": "journal.openPrevious",
        "title": "%command.journal.openPrevious.title%",
        "category": "%command.category.journal%"
      },
      {
        "command": "journal.openNext",
        "title": "%command.journal.openNext.title%",
        "category": "%command.category.journal%"
      }
    ],
    "keybindings": [
      {
        "command": "journal.day",
        "key": "ctrl+shift+j",
        "mac": "cmd+shift+j"
      },
      {
        "command": "journal.printDuration",
        "key": "ctrl+j d",
        "mac": "cmd+j d",
        "when": "editorTextFocus && editorHasMultipleSelections"
      },
      {
        "command": "journal.printSum",
        "key": "ctrl+j s",
        "mac": "cmd+j s",
        "when": "editorTextFocus && editorHasMultipleSelections"
      },
      {
        "command": "journal.openPrevious",
        "key": "ctrl+j ,",
        "mac": "cmd+j ,",
        "when": "editorTextFocus"
      },
      {
        "command": "journal.openNext",
        "key": "ctrl+j .",
        "mac": "cmd+j .",
        "when": "editorTextFocus"
      }
    ],
    "grammars": [
      {
        "scopeName": "text.markdown.journal",
        "path": "./res/syntax/journal-markdown.json",
        "injectTo": [
          "text.html.markdown"
        ]
      }
    ],
    "snippets": [
      {
        "language": "markdown",
        "path": "./res/snippets/markdown.json"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "%configuration.title%",
      "properties": {
        "journal.base": {
          "type": "string",
          "default": "",
          "markdownDescription": "%configuration.journal.base.description%"
        },
        "journal.ext": {
          "type": "string",
          "default": "md",
          "description": "%configuration.journal.ext.description%"
        },
        "journal.locale": {
          "type": "string",
          "default": "",
          "description": "%configuration.journal.locale.description%"
        },
        "journal.syntax-highlighting": {
          "type": "boolean",
          "default": "false",
          "description": "%configuration.journal.syntax-highlighting.description%"
        },
        "journal.patterns": {
          "type": "object",
          "editPresentation": "multilineText",
          "default": {
            "notes": {
              "path": "${base}/${year}/${month}/${day}",
              "file": "${input}.${ext}"
            },
            "entries": {
              "path": "${base}/${year}/${month}",
              "file": "${day}.${ext}"
            },
            "weeks": {
              "path": "${base}/${year}",
              "file": "week_${week}.${ext}"
            },
            "weeklyNotes": {
              "path": "${base}/${year}/w${week}",
              "file": "${input}.${ext}"
            }
          },
          "description": "%configuration.journal.patterns.description%"
        },
        "journal.entryGranularity": {
          "type": "string",
          "enum": [
            "daily",
            "weekly"
          ],
          "default": "daily",
          "description": "%configuration.journal.entryGranularity.description%"
        },
        "journal.tpl-entry": {
          "type": "string",
          "default": "",
          "description": "The template string for your daily journal entries. Please edit directly in settings.json to include linebreaks. ",
          "markdownDeprecationMessage": "This setting is outdated, please use the setting `#journal.templates#` instead.",
          "deprecationMessage ": "This setting is outdated, please use the setting `#journal.templates#` instead."
        },
        "journal.tpl-time": {
          "type": "string",
          "default": "",
          "description": "The template string for inserting the current time at the cursor location. Defaults to local time. ",
          "markdownDeprecationMessage": "This setting is outdated, please use the setting `#journal.templates#` instead.",
          "deprecationMessage ": "This setting is outdated, please use the setting `#journal.templates#` instead."
        },
        "journal.tpl-note": {
          "type": "string",
          "default": "",
          "description": "The template string for your notes.",
          "markdownDeprecationMessage": "This setting is outdated, please use the setting `#journal.templates#` instead.",
          "deprecationMessage ": "This setting is outdated, please use the setting `#journal.templates#` instead."
        },
        "journal.tpl-memo": {
          "type": "string",
          "default": "- MEMO: ${input}",
          "description": "The template string for new memos (new lines).",
          "markdownDeprecationMessage": "This setting is outdated, please use the setting `#journal.templates#` instead.",
          "deprecationMessage ": "This setting is outdated, please use the setting `#journal.templates#` instead."
        },
        "journal.tpl-memo-after": {
          "type": "string",
          "default": "",
          "description": "Where to place new memos. (Default is empty, which means after the header)",
          "markdownDeprecationMessage": "This setting is outdated, please use the setting `#journal.templates#` instead.",
          "deprecationMessage ": "This setting is outdated, please use the setting `#journal.templates#` instead."
        },
        "journal.tpl-task": {
          "type": "string",
          "default": "- [ ] TASK: ${input}",
          "description": "The template string for new tasks.",
          "markdownDeprecationMessage": "This setting is outdated, please use the setting `#journal.templates#` instead.",
          "deprecationMessage ": "This setting is outdated, please use the setting `#journal.templates#` instead."
        },
        "journal.tpl-task-after": {
          "type": "string",
          "default": "",
          "description": "Where to place the tasks. (Default is empty, which means after the header).",
          "markdownDeprecationMessage": "This setting is outdated, please use the setting `#journal.templates#` instead.",
          "deprecationMessage ": "This setting is outdated, please use the setting `#journal.templates#` instead."
        },
        "journal.tpl-todo": {
          "type": "string",
          "default": "",
          "description": "The template string for new todos.",
          "markdownDeprecationMessage": "This setting is outdated, please use the setting `#journal.templates#` instead.",
          "deprecationMessage ": "This setting is outdated, please use the setting `#journal.templates#` instead."
        },
        "journal.tpl-todo-after": {
          "type": "string",
          "default": "",
          "description": "Where to place the todos. (Default is empty, which means after the header).",
          "markdownDeprecationMessage": "This setting is outdated, please use the setting `#journal.templates#` instead.",
          "deprecationMessage ": "This setting is outdated, please use the setting `#journal.templates#` instead."
        },
        "journal.tpl-files": {
          "type": "string",
          "default": "",
          "description": "Template for the link to notes",
          "markdownDeprecationMessage": "This setting is outdated, please use the setting `#journal.templates#` instead.",
          "deprecationMessage ": "This setting is outdated, please use the setting `#journal.templates#` instead."
        },
        "journal.tpl-files-after": {
          "type": "string",
          "default": "",
          "description": "Where to place the file links to notes and more. (Default is empty, which means after the header).",
          "markdownDeprecationMessage": "This setting is outdated, please use the setting `#journal.templates#` instead.",
          "deprecationMessage ": "This setting is outdated, please use the setting `#journal.templates#` instead."
        },
        "journal.dev": {
          "type": "boolean",
          "default": "false",
          "description": "%configuration.journal.dev.description%"
        },
        "journal.navigation.mode": {
          "type": "string",
          "enum": ["existing", "calendar"],
          "default": "existing",
          "description": "%configuration.journal.navigation.mode.description%"
        },
        "journal.openInNewEditorGroup": {
          "type": "boolean",
          "default": false,
          "description": "%configuration.journal.openInNewEditorGroup.description%"
        },
        "journal.scopes": {
          "type": "array",
          "editPresentation": "multilineText",
          "default": {},
          "markdownDescription": "%configuration.journal.scopes.description%"
        },
        "journal.templates": {
          "type": "array",
          "editPresentation": "multilineText",
          "default": [
            {
              "name": "memo",
              "template": "- MEMO ${localTime}: ${input}"
            },
            {
              "name": "task",
              "template": "- [] ${d:LL} - Task: ${input}",
              "after": "## Tasks"
            },
            {
              "name": "entry",
              "template": "# ${d:dddd, MMMM DD YYYY}\n\n## Tasks\n\n## Notes\n\n"
            },
            {
              "name": "time",
              "template": "${localTime}"
            },
            {
              "name": "note",
              "template": "# ${input}\n\n${tags}\n"
            },
            {
              "name": "files",
              "template": "- NOTE: [${title}](${link})",
              "after": "## Notes"
            },
            {
              "name": "weekly",
              "template": "# Week ${week}\n\n## Tasks\n\n## Notes\n\n## Daily Entries\n\n"
            },
            {
              "name": "dailyLink",
              "template": "- [${weekday}, ${d:MMMM DD}](${link})",
              "after": "## Daily Entries"
            }
          ],
          "markdownDescription": "%configuration.journal.templates.description%"
        },
        "journal.weeklySync": {
          "type": "object",
          "default": {
            "enabled": true,
            "anchor": "## Daily Entries",
            "template": "- [${weekday}, ${d:MMMM DD}](${link})",
            "sortOrder": "ascending"
          },
          "description": "%configuration.journal.weeklySync.description%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "node esbuild.mjs",
    "l10n:export": "vscode-l10n-dev export --outDir ./l10n ./src",
    "watch": "node esbuild.mjs --watch",
    "package": "node esbuild.mjs --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "check": "npm run lint && npm run compile && npm run test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.118.0",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "@vscode/l10n-dev": "^0.0.35",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.4",
    "mocha": "^11.7.5",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "moment": "^2.29.4"
  },
  "overrides": {
    "serialize-javascript": ">=7.0.5"
  }
}
